# Server only. Copy outside the repository to /etc/tft/server.env (0600).
NODE_ENV=production
TFT_ENV=private
HOST=127.0.0.1
PORT=2567
TFT_PUBLIC_URL=https://game.example.invalid
TFT_ALLOWED_ORIGINS=https://game.example.invalid
TFT_PROXY_ADDRESS=127.0.0.1
TFT_STATIC_DIR=/opt/tft/current/apps/web/dist
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Existing durable adapter uses Supabase RPC over HTTPS, not a new DATABASE_URL.
# Never put database credentials, service-role or diagnostic variables in VITE_.

# Final result reconnect window; 30000–3600000 ms in private/production.
TFT_FINAL_RETENTION_MS=300000
