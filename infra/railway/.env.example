# Server runtime values. Set in Railway, never copy a real .env into a release.
NODE_ENV=production
TFT_ENV=private
HOST=0.0.0.0
TFT_PROXY_MODE=railway
TFT_PUBLIC_URL=https://YOUR_APPROVED_DOMAIN
TFT_ALLOWED_ORIGINS=https://YOUR_APPROVED_DOMAIN
TFT_FINAL_RETENTION_MS=300000
TFT_STATIC_DIR=apps/web/dist
NODE_OPTIONS=--max-old-space-size=1280
SUPABASE_URL=https://YOUR_EXISTING_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_KEY
SUPABASE_SERVICE_ROLE_KEY=SET_ONLY_IN_RAILWAY_SECRETS
# PORT and RAILWAY_* identity values are platform-injected, not invented here.
# No TFT_PROXY_ADDRESS, TCP proxy, diagnostic variables or DATABASE_URL.
